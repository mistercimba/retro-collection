# Google Sheets (server-side only)
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional. Used server-side for live catalogue metadata and time-to-beat.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional. RAWG supplies platform-specific Metacritic scores; requires a private app and attribution.
RAWG_API_KEY=

# Read-only fine-grained GitHub token for mistercimba/vinted-retro-search.
PRICECHARTING_CATALOG_GITHUB_TOKEN=
# Optional branch/tag for the catalog snapshot (defaults to main).
PRICECHARTING_CATALOG_REF=main

# Optional. Set to "mock" to force demonstration data, or "google" to require live Sheets.
DATA_PROVIDER=auto

# Required in production to protect the personal collection.
APP_PASSWORD=
