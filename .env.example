# Runtime server-side: credentials for the private Vercel Blob store.
# library-store.ts uses @vercel/blob get/put without an explicit token;
# the installed SDK reads BLOB_READ_WRITE_TOKEN from the environment.
# The store must already contain a valid retro-collection/library.json.
BLOB_READ_WRITE_TOKEN=

# Configure this to protect the private app. If empty, the auth gate is disabled.
APP_PASSWORD=

# Optional for browsing; required to show PriceCharting reference prices.
# Read-only Contents token scoped to mistercimba/vinted-retro-search.
PRICECHARTING_CATALOG_GITHUB_TOKEN=
# Optional catalog branch/tag; defaults to main.
PRICECHARTING_CATALOG_REF=main

# Google/IGDB/RAWG credentials and DATA_PROVIDER are not runtime requirements.
# Legacy maintenance scripts have separate requirements; consult README/scripts.
