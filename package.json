{
  "name": "retro-collection",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first personal retro game collection browser.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "artwork:import": "node scripts/import-thegamesdb-artwork.mjs",
    "artwork:status": "node scripts/artwork-status.mjs",
    "artwork:fallback": "node scripts/import-gametdb-fallback.mjs",
    "artwork:sony": "node scripts/import-libretro-serial-artwork.mjs",
    "artwork:nintendo": "node scripts/import-libretro-nintendo-serial-artwork.mjs",
    "artwork:strict-fallback": "node scripts/import-strict-libretro-fallback.mjs",
    "metadata:refresh": "node scripts/refresh-game-metadata.mjs",
    "collection:refresh": "node scripts/refresh-collection-snapshot.mjs",
    "wishlist-artwork:import": "node scripts/import-wishlist-artwork.mjs",
    "wishlist-artwork:candidates": "node scripts/generate-wishlist-artwork-candidates.mjs",
    "wishlist-artwork:materialize-candidates": "node scripts/materialize-wishlist-artwork-candidates.mjs",
    "wishlist-artwork:check-candidates": "node scripts/materialize-wishlist-artwork-candidates.mjs --check"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "google-auth-library": "11.1.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@vercel/blob": "2.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "5.0.2"
  }
}
